---
import HandShape from './HandShape.astro';
---

<svg class="honey-hand" viewBox="0 0 90 150" aria-hidden="true" focusable="false">
	<g class="honey-hand__held">
		<rect class="honey-hand__arm" x="30" y="-60" width="28" height="140" />
		<g transform="translate(8 70)">
			<HandShape />
		</g>
		<g class="honey-hand__jar">
			<rect x="28" y="84" width="34" height="38" rx="8" />
			<rect class="honey-hand__lid" x="30" y="78" width="30" height="8" rx="3" />
			<path class="honey-hand__drip" d="M45 122 C41 130 41 136 45 138 C49 136 49 130 45 122Z" />
		</g>
	</g>
</svg>

<style>
	.honey-hand {
		width: 5.5rem;
		height: auto;
		overflow: visible;
	}

	.honey-hand__arm {
		fill: #3a5a9a;
		stroke: #3a2112;
		stroke-width: 2.5;
	}

	.honey-hand__jar rect {
		fill: #f0a830;
		stroke: #3a2112;
		stroke-width: 2.5;
	}

	.honey-hand__jar .honey-hand__lid {
		fill: #8a5230;
	}

	.honey-hand__drip {
		fill: #f0a830;
		stroke: #3a2112;
		stroke-width: 2;
		opacity: 0;
	}

	.honey-hand__held {
		transform-origin: 45px 0;
		transform: translateY(calc((1 - var(--hand-progress, 0)) * -60px));
	}

	:global(.hand[data-state='refreshing']) .honey-hand__jar {
		transform-origin: 45px 100px;
		animation: honey-hand-tilt 0.9s ease-in-out infinite alternate;
	}

	:global(.hand[data-state='refreshing']) .honey-hand__drip {
		animation: honey-hand-drip 0.9s ease-in infinite;
	}

	@keyframes honey-hand-tilt {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(-25deg);
		}
	}

	@keyframes honey-hand-drip {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(24px);
		}
	}
</style>
