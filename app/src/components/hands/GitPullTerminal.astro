<div class="git-pull-terminal" aria-hidden="true">
	<p class="git-pull-terminal__line" style="--line-index: 0">$ git pull</p>
	<p class="git-pull-terminal__line" style="--line-index: 1">remote: Enumerating objects…</p>
	<p class="git-pull-terminal__line" style="--line-index: 2">Receiving objects: 100%</p>
	<p class="git-pull-terminal__line git-pull-terminal__line--done" style="--line-index: 3">Fast-forward</p>
</div>

<style>
	.git-pull-terminal {
		width: min(18rem, 80vw);
		padding: 0.6rem 0.8rem;
		border: 1px solid var(--color-accent);
		border-radius: 0.5rem;
		background: #0b0f1d;
		color: #7ee8a6;
		font-family: var(--font-heading);
		font-size: 0.75rem;
		transform: translateY(calc((1 - var(--hand-progress, 0)) * -100%));
	}

	.git-pull-terminal__line {
		margin: 0;
		white-space: nowrap;
		opacity: clamp(0, calc(var(--hand-progress, 0) * 4 - var(--line-index)), 1);
	}

	.git-pull-terminal__line--done {
		color: var(--color-accent);
	}

	:global(.hand[data-state='refreshing']) .git-pull-terminal__line {
		opacity: 1;
		animation: git-pull-terminal-blink 0.8s steps(2) infinite;
		animation-delay: calc(var(--line-index) * 0.15s);
	}

	@keyframes git-pull-terminal-blink {
		50% {
			opacity: 0.4;
		}
	}
</style>
