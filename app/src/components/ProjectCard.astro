---
import PipelineDiagram from './PipelineDiagram.astro';

interface Props {
	slug: string;
	index: number;
	name: string;
	summary: string;
	plain: string;
	plain_label: string;
	technologies: string[];
	repository: string;
	highlights: string[];
	pipeline_steps?: string[];
	pipeline_label?: string;
	details_label: string;
	repository_label: string;
}

const { slug, index, name, summary, plain, plain_label, technologies, repository, highlights, pipeline_steps, pipeline_label, details_label, repository_label } =
	Astro.props;
---

<div class="project-wrap" data-reveal style={`--delay: ${(index % 2) * 90}ms`}>
<article class="project glass spot" data-tilt>
	<div class="project__bar" aria-hidden="true">
		<span></span><span></span><span></span>
		<code>~/projects/{slug}</code>
		<b>{String(index + 1).padStart(2, '0')}</b>
	</div>
	<div class="project__body">
		<h3 class="project__name">{name}</h3>
		<p class="project__summary">{summary}</p>
		<p class="project__plain"><b>{plain_label}</b>{plain}</p>
		{pipeline_steps && pipeline_label && <PipelineDiagram steps={pipeline_steps} label={pipeline_label} />}
		<ul class="project__technologies">
			{technologies.map((technology) => <li class="chip">{technology}</li>)}
		</ul>
		<details class="project__details">
			<summary>{details_label} <span aria-hidden="true">+</span></summary>
			<ul class="project__highlights">
				{highlights.map((highlight) => <li>{highlight}</li>)}
			</ul>
		</details>
		<a class="btn project__repository" href={repository} rel="noopener" target="_blank">
			{repository_label} <span aria-hidden="true">↗</span>
		</a>
	</div>
</article>
</div>

<style>
	.project-wrap {
		display: flex;
	}

	.project {
		flex: 1;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition:
			transform 0.2s ease-out,
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	.project:hover {
		border-color: color-mix(in srgb, var(--accent) 55%, transparent);
		box-shadow: 0 30px 70px -30px color-mix(in srgb, var(--accent) 45%, transparent);
	}

	.project__bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.7rem 1.1rem;
		border-bottom: 1px solid var(--border);
		background: var(--surface);
	}

	.project__bar span {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: #ff5f57;
	}

	.project__bar span:nth-child(2) {
		background: #febc2e;
	}

	.project__bar span:nth-child(3) {
		background: #28c840;
	}

	.project__bar code {
		margin-left: 0.6rem;
		color: var(--muted);
		font: 400 0.78rem var(--font-heading);
	}

	.project__bar b {
		margin-left: auto;
		color: var(--accent);
		font: 700 0.78rem var(--font-heading);
	}

	.project__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 1.1rem;
		padding: clamp(1.25rem, 3vw, 1.8rem);
	}

	.project__name {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 800;
	}

	.project__summary {
		margin-top: -0.5rem;
		color: var(--muted);
	}

	.project__plain {
		padding: 0.9rem 1rem;
		border-left: 3px solid var(--accent);
		border-radius: 0 0.75rem 0.75rem 0;
		background: var(--surface);
		font-size: 1rem;
	}

	.project__plain b {
		display: block;
		margin-bottom: 0.2rem;
		color: var(--accent);
		font: 500 0.72rem var(--font-heading);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.project__technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0;
		list-style: none;
	}

	.project__details {
		border-top: 1px solid var(--border);
		padding-top: 0.9rem;
	}

	.project__details summary {
		display: flex;
		justify-content: space-between;
		color: var(--text);
		font-weight: 600;
		cursor: pointer;
		list-style: none;
	}

	.project__details summary::-webkit-details-marker {
		display: none;
	}

	.project__details summary span {
		color: var(--accent);
		font-family: var(--font-heading);
		transition: transform 0.25s ease;
	}

	.project__details[open] summary span {
		transform: rotate(45deg);
	}

	.project__highlights {
		display: grid;
		gap: 0.8rem;
		margin-top: 1rem;
		padding-left: 1.1rem;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.project__highlights li::marker {
		color: var(--accent);
	}

	.project__repository {
		align-self: flex-start;
		margin-top: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.project,
		.project__details summary span {
			transition: none;
		}
	}
</style>
