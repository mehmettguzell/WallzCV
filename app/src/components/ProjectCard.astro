---
import PipelineDiagram from './PipelineDiagram.astro';

interface Props {
	slug: string;
	index: number;
	name: string;
	tagline: string;
	points: string[];
	technologies: string[];
	repository?: string;
	pipeline_steps?: string[];
	pipeline_label?: string;
	repository_label: string;
}

const { slug, index, name, tagline, points, technologies, repository, pipeline_steps, pipeline_label, repository_label } =
	Astro.props;
---

<div class="project-wrap" data-reveal style={`--delay: ${(index % 2) * 90}ms`}>
	<article class="project glass spot" data-tilt>
		<div class="project__bar" aria-hidden="true">
			<span></span><span></span><span></span>
			<code>~/projects/{slug}</code>
			<b>{String(index + 1).padStart(2, '0')}</b>
		</div>
		<div class="project__body">
			<h3 class="project__name">{name}</h3>
			<p class="project__tagline">{tagline}</p>
			<ul class="project__points">
				{points.map((point) => <li>{point}</li>)}
			</ul>
			{pipeline_steps && pipeline_label && <PipelineDiagram steps={pipeline_steps} label={pipeline_label} />}
			<ul class="project__technologies">
				{technologies.map((technology) => <li class="chip">{technology}</li>)}
			</ul>
			{
				repository && (
					<a class="btn project__repository" href={repository} rel="noopener" target="_blank">
						{repository_label} <span aria-hidden="true">↗</span>
					</a>
				)
			}
		</div>
	</article>
</div>

<style>
	.project-wrap {
		display: flex;
	}

	.project {
		flex: 1;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition:
			transform 0.2s ease-out,
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	.project:hover {
		border-color: color-mix(in srgb, var(--accent) 55%, transparent);
		box-shadow: 0 30px 70px -30px color-mix(in srgb, var(--accent) 45%, transparent);
	}

	.project__bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.7rem 1.1rem;
		border-bottom: 1px solid var(--border);
		background: var(--surface);
	}

	.project__bar span {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: #ff5f57;
	}

	.project__bar span:nth-child(2) {
		background: #febc2e;
	}

	.project__bar span:nth-child(3) {
		background: #28c840;
	}

	.project__bar code {
		margin-left: 0.6rem;
		color: var(--muted);
		font: 400 0.78rem var(--font-heading);
	}

	.project__bar b {
		margin-left: auto;
		color: var(--accent);
		font: 700 0.78rem var(--font-heading);
	}

	.project__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 1.1rem;
		padding: clamp(1.25rem, 3vw, 1.8rem);
	}

	.project__name {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 800;
	}

	.project__tagline {
		margin-top: -0.5rem;
		font-size: 1.05rem;
		font-weight: 500;
	}

	.project__points {
		display: grid;
		gap: 0.7rem;
		padding-left: 1.1rem;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.project__points li::marker {
		color: var(--accent);
	}

	.project__technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0;
		list-style: none;
	}

	.project__repository {
		align-self: flex-start;
		margin-top: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.project {
			transition: none;
		}
	}
</style>
