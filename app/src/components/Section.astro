---
interface Props {
	id: string;
	eyebrow: string;
	title: string;
	lead?: string;
}

const { id, eyebrow, title, lead } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
	<div class="container">
		<header class="section__header" data-reveal>
			<p class="eyebrow">{eyebrow}</p>
			<h2 class="section__title" id={`${id}-title`}>{title}</h2>
			{lead && <p class="section__lead">{lead}</p>}
		</header>
		<slot />
	</div>
</section>

<style>
	.section__header {
		margin-bottom: clamp(2rem, 5vw, 3.5rem);
	}
</style>
