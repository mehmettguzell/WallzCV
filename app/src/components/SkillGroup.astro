---
interface Props {
	label: string;
	skills: string[];
	index: number;
}

const { label, skills, index } = Astro.props;
---

<article class="skill-group glass spot" data-reveal style={`--delay: ${(index % 4) * 70}ms`}>
	<h3 class="skill-group__label"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{label}</h3>
	<ul class="skill-group__skills">
		{skills.map((skill) => <li class="chip">{skill}</li>)}
	</ul>
</article>

<style>
	.skill-group {
		padding: 1.5rem;
	}

	.skill-group__label {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		margin-bottom: 1rem;
		font-size: 1.1rem;
	}

	.skill-group__label span {
		color: var(--accent);
		font: 500 0.75rem var(--font-heading);
	}

	.skill-group__skills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		padding: 0;
		list-style: none;
	}

	.skill-group__skills .chip {
		white-space: normal;
	}
</style>
