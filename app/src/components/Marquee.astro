---
interface Props {
	label: string;
	rows: string[][];
}

const { label, rows } = Astro.props;
---

<div class="marquee" role="region" aria-label={label}>
	{
		rows.map((items, row_index) => (
			<div class={`marquee__row${row_index % 2 === 1 ? ' marquee__row--reverse' : ''}`} aria-hidden={row_index > 0 ? 'true' : undefined}>
				{[0, 1].map((copy) => (
					<ul class="marquee__track" aria-hidden={copy === 1 ? 'true' : undefined}>
						{items.map((item) => (
							<li class="chip">{item}</li>
						))}
					</ul>
				))}
			</div>
		))
	}
</div>

<style>
	.marquee {
		display: grid;
		gap: 0.9rem;
		overflow: hidden;
		padding-block: 1.5rem;
		mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
	}

	.marquee__row {
		display: flex;
		width: max-content;
		animation: marquee 55s linear infinite;
	}

	.marquee__row--reverse {
		animation-direction: reverse;
		animation-duration: 70s;
	}

	.marquee:hover .marquee__row {
		animation-play-state: paused;
	}

	.marquee__track {
		display: flex;
		gap: 0.9rem;
		padding-right: 0.9rem;
		list-style: none;
	}

	.marquee__track .chip {
		padding: 0.55rem 1.2rem;
		font-size: 0.88rem;
	}

	@keyframes marquee {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee__row {
			animation: none;
			flex-wrap: wrap;
			width: auto;
		}

		.marquee__track:nth-child(2) {
			display: none;
		}
	}
</style>
