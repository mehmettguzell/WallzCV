---
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { t, type Language } from '../i18n';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;

const section_links = [
	{ id: 'about', label: t(lang, 'nav.about') },
	{ id: 'experience', label: t(lang, 'nav.experience') },
	{ id: 'projects', label: t(lang, 'nav.projects') },
	{ id: 'skills', label: t(lang, 'nav.skills') },
	{ id: 'contact', label: t(lang, 'nav.contact') },
];
---

<header class="site-header">
	<div class="site-header__bar glass">
		<a class="site-header__brand" href={`/${lang}/`} aria-label="Mehmet Güzel">
			<img class="site-header__logo" src="/mehmet-guzel.png" alt="" width="32" height="32" />
			<span class="site-header__name">Mehmet <span class="gradient-text">Güzel</span></span>
		</a>

		<nav class="site-header__nav" id="site-nav" aria-label={t(lang, 'nav.label')}>
			{section_links.map((link) => <a href={`/${lang}/#${link.id}`} data-section={link.id}>{link.label}</a>)}
			<a href={`/${lang}/blog/`} data-section="blog-page">{t(lang, 'nav.blog')}</a>
		</nav>

		<div class="site-header__actions">
			<details class="cv-menu">
				<summary class="btn btn--primary cv-menu__summary">{t(lang, 'nav.cv_download')}</summary>
				<ul class="cv-menu__list glass">
					<li>
						<a href="/Mehmet_Guzel_CV_EN.pdf" download hreflang="en">{t(lang, 'nav.cv_english')}</a>
					</li>
					<li>
						<a href="/Mehmet_Guzel_CV.pdf" download hreflang="tr">{t(lang, 'nav.cv_turkish')}</a>
					</li>
				</ul>
			</details>
			<LanguageSwitch lang={lang} />
			<ThemeToggle label={t(lang, 'theme.toggle')} />
			<button
				type="button"
				class="site-header__burger"
				aria-label={t(lang, 'nav.menu')}
				aria-expanded="false"
				aria-controls="site-nav"
			>
				<span></span><span></span><span></span>
			</button>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('.site-header');
	const burger = header?.querySelector<HTMLButtonElement>('.site-header__burger');
	const nav_links = header?.querySelectorAll<HTMLAnchorElement>('.site-header__nav a') ?? [];
	const cv_menu = header?.querySelector<HTMLDetailsElement>('.cv-menu');

	const set_menu_open = (open: boolean) => {
		header?.classList.toggle('is-open', open);
		burger?.setAttribute('aria-expanded', String(open));
	};

	burger?.addEventListener('click', () => set_menu_open(!header?.classList.contains('is-open')));
	nav_links.forEach((link) => link.addEventListener('click', () => set_menu_open(false)));

	document.addEventListener('click', (event) => {
		if (cv_menu?.open && !cv_menu.contains(event.target as Node)) cv_menu.open = false;
	});
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		set_menu_open(false);
		if (cv_menu?.open) {
			cv_menu.open = false;
			cv_menu.querySelector('summary')?.focus();
		}
	});

	const stuck_class = 'is-stuck';
	const update_stuck = () => header?.classList.toggle(stuck_class, scrollY > 24);
	addEventListener('scroll', update_stuck, { passive: true });
	update_stuck();

	if (location.pathname.includes('/blog')) {
		header?.querySelector('[data-section="blog-page"]')?.setAttribute('aria-current', 'page');
	}

	const observed_sections = [...nav_links]
		.map((link) => document.getElementById(link.dataset.section ?? ''))
		.filter((section): section is HTMLElement => section !== null);

	if (observed_sections.length > 0) {
		const section_observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					nav_links.forEach((link) =>
						link.toggleAttribute('aria-current', link.dataset.section === entry.target.id),
					);
				}
			},
			{ rootMargin: '-45% 0px -50% 0px' },
		);
		observed_sections.forEach((section) => section_observer.observe(section));
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0.75rem;
		z-index: 50;
		width: min(100% - 1.5rem, 68rem);
		margin: 0.75rem auto 0;
	}

	.site-header__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.5rem 0.6rem 0.5rem 0.9rem;
		border-radius: 999px;
		transition:
			box-shadow 0.3s ease,
			background 0.3s ease;
	}

	.site-header.is-stuck .site-header__bar {
		background: color-mix(in srgb, var(--bg) 72%, transparent);
	}

	.site-header__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--text);
		font-family: var(--font-heading);
		font-weight: 700;
		text-decoration: none;
	}

	.site-header__logo {
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		object-fit: cover;
	}

	.site-header__nav {
		display: flex;
		gap: 0.15rem;
	}

	.site-header__nav a {
		position: relative;
		padding: 0.45rem 0.85rem;
		border-radius: 999px;
		color: var(--muted);
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}

	.site-header__nav a:hover {
		color: var(--text);
	}

	.site-header__nav a[aria-current] {
		background: var(--surface-strong);
		color: var(--text);
		box-shadow: inset 0 0 0 1px var(--border);
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.cv-menu {
		position: relative;
	}

	.cv-menu__summary {
		padding: 0.5rem 1.1rem;
		font-size: 0.88rem;
		white-space: nowrap;
		list-style: none;
	}

	.cv-menu__summary::-webkit-details-marker {
		display: none;
	}

	.cv-menu__list {
		position: absolute;
		top: calc(100% + 0.6rem);
		right: 0;
		min-width: 10rem;
		padding: 0.4rem;
		border-radius: 1rem;
		background: color-mix(in srgb, var(--bg) 92%, var(--text));
		list-style: none;
	}

	.cv-menu__list a {
		display: block;
		padding: 0.55rem 0.9rem;
		border-radius: 0.65rem;
		color: var(--text);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.cv-menu__list a:hover {
		background: var(--surface-strong);
	}

	.site-header__burger {
		display: none;
		width: 2.4rem;
		height: 2.4rem;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: var(--surface);
		cursor: pointer;
	}

	.site-header__burger span {
		display: block;
		width: 1rem;
		height: 2px;
		margin: 3px auto;
		border-radius: 2px;
		background: var(--text);
		transition:
			transform 0.25s ease,
			opacity 0.25s ease;
	}

	.is-open .site-header__burger span:nth-child(1) {
		transform: translateY(5px) rotate(45deg);
	}

	.is-open .site-header__burger span:nth-child(2) {
		opacity: 0;
	}

	.is-open .site-header__burger span:nth-child(3) {
		transform: translateY(-5px) rotate(-45deg);
	}

	@media (max-width: 960px) {
		.site-header__burger {
			display: inline-block;
		}

		.site-header__nav {
			position: absolute;
			top: calc(100% + 0.6rem);
			left: 0;
			right: 0;
			flex-direction: column;
			padding: 0.6rem;
			border: 1px solid var(--border);
			border-radius: 1.25rem;
			background: color-mix(in srgb, var(--bg) 94%, var(--text));
			box-shadow: var(--shadow);
			opacity: 0;
			transform: translateY(-0.5rem);
			pointer-events: none;
			visibility: hidden;
			transition:
				opacity 0.25s ease,
				transform 0.25s ease,
				visibility 0.25s;
		}

		.is-open .site-header__nav {
			opacity: 1;
			transform: none;
			pointer-events: auto;
			visibility: visible;
		}

		.site-header__nav a {
			padding: 0.8rem 1rem;
			font-size: 1rem;
		}
	}

	@media (max-width: 520px) {
		.site-header__name {
			display: none;
		}

		.site-header__actions {
			gap: 0.4rem;
		}

		.cv-menu__summary {
			padding-inline: 0.85rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header__nav,
		.site-header__nav a,
		.site-header__burger span {
			transition: none;
		}
	}
</style>
