---
import Layout from '../../../layouts/Layout.astro';
import UpcomingTopics from '../../../components/UpcomingTopics.astro';
import { languages, t, type Language } from '../../../i18n';
import { estimate_reading_minutes, get_published_posts_newest_first } from '../../../lib/blog';

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const posts = await get_published_posts_newest_first();
const date_format = new Intl.DateTimeFormat(lang, { dateStyle: 'medium' });
---

<Layout lang={lang} title={`${t(lang, 'blog.title')} · Mehmet Güzel`} description={t(lang, 'meta.blog_description')}>
	<section class="blog-list container">
		<p class="eyebrow">{t(lang, 'blog.eyebrow')}</p>
		<h1 class="section__title">{t(lang, 'blog.heading')}</h1>
		<UpcomingTopics lang={lang} />
		{posts.length === 0 && <p>{t(lang, 'blog.empty')}</p>}
		<ul class="blog-list__posts">
			{
				posts.map((post) => (
					<li class="blog-list__post glass spot">
						<h2>
							<a href={`/${lang}/blog/${post.id}/`} hreflang={post.data.lang}>{post.data.title}</a>
						</h2>
						<p class="blog-list__meta">
							<time datetime={post.data.date.toISOString()}>{date_format.format(post.data.date)}</time>
							· {post.data.lang.toUpperCase()} · {estimate_reading_minutes(post)} {t(lang, 'blog.reading_minutes')}
						</p>
						<p lang={post.data.lang}>{post.data.summary}</p>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<style>
	.blog-list {
		padding-block: clamp(3rem, 7vw, 5rem);
	}

	.blog-list__posts {
		display: grid;
		gap: 1.1rem;
		margin-top: 2rem;
		padding: 0;
		list-style: none;
	}

	.blog-list__post {
		padding: 1.75rem;
		color: var(--muted);
	}

	.blog-list__post h2 {
		margin-bottom: 0.4rem;
		font-size: 1.5rem;
	}

	.blog-list__post h2 a {
		color: var(--text);
		text-decoration: none;
	}

	.blog-list__post h2 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.blog-list__post:hover h2 a {
		color: var(--accent);
	}

	.blog-list__meta {
		margin-bottom: 0.6rem;
		font-family: var(--font-heading);
		font-size: 0.8rem;
	}
</style>
