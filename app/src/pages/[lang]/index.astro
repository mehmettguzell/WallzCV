---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import ExperienceItem from '../../components/ExperienceItem.astro';
import SkillGroup from '../../components/SkillGroup.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import { languages, t, type Language } from '../../i18n';
import experience from '../../data/experience.json';
import projects from '../../data/projects.json';
import skills from '../../data/skills.json';
import education from '../../data/education.json';
import contact from '../../data/contact.json';

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;

const education_icons = {
	degree: 'M1 6l7-3.5L15 6l-7 3.5zM4 7.5V11c0 1 1.8 2 4 2s4-1 4-2V7.5',
	trophy: 'M5 2h6v4a3 3 0 0 1-6 0zM5 3.5H2.5V5A2.5 2.5 0 0 0 5 7.5M11 3.5h2.5V5A2.5 2.5 0 0 1 11 7.5M8 9v3M5.5 14h5',
	certificate: 'M2.5 2.5h11v8h-11zM5 5.5h6M5 8h3M10.5 10.5l1 3-1.5-.8-1.5.8z',
};

const pillars = [1, 2, 3, 4].map((number) => ({
	title: t(lang, `pillar.${number}.title` as 'pillar.1.title'),
	body: t(lang, `pillar.${number}.body` as 'pillar.1.body'),
}));
---

<Layout lang={lang} title={t(lang, 'home.title')} description={t(lang, 'meta.home_description')}>
	<Hero lang={lang} />

	<Section id="about" eyebrow={t(lang, 'about.eyebrow')} title={t(lang, 'about.heading')}>
		<div class="pillars">
			{
				pillars.map((pillar, index) => (
					<article class="pillar glass spot" data-reveal style={`--delay: ${index * 70}ms`}>
						<span class="pillar__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
						<h3>{pillar.title}</h3>
						<p>{pillar.body}</p>
					</article>
				))
			}
		</div>
	</Section>

	<Section id="experience" eyebrow={t(lang, 'experience.eyebrow')} title={t(lang, 'experience.heading')}>
		<div class="timeline">
			<span class="timeline__rail" aria-hidden="true"><span class="timeline__fill"></span></span>
			{
				experience.map((item) => (
					<ExperienceItem
						role={item.role[lang]}
						summary={item.summary[lang]}
						organization={item.organization}
						location={item.location[lang]}
						period={item.period[lang]}
						highlights={item.highlights.map((highlight) => highlight[lang])}
						technologies={item.technologies}
						technologies_label={t(lang, 'experience.stack')}
						proof={'proof' in item ? { ...item.proof, title: t(lang, 'experience.proof') } : undefined}
					/>
				))
			}
		</div>
	</Section>

	<Section id="projects" eyebrow={t(lang, 'projects.eyebrow')} title={t(lang, 'projects.heading')} lead={t(lang, 'projects.lead')}>
		<div class="project-grid">
			{
				projects.map((project, index) => (
					<ProjectTile
						slug={project.slug}
						index={index}
						name={project.name}
						tagline={project.tagline[lang]}
						architecture_styles={project.architecture_style.map((style) => style[lang])}
						context={'context' in project ? project.context[lang] : undefined}
						technologies={project.technologies}
						status_label={'in_progress' in project && project.in_progress ? t(lang, 'projects.in_progress') : undefined}
						open_label={t(lang, 'projects.open_details')}
						close_label={t(lang, 'projects.close_details')}
					>
					<ProjectCard
						slug={project.slug}
						index={index}
						name={project.name}
						context={'context' in project ? project.context[lang] : undefined}
						release_status={
							'release_status' in project
								? {
										title: project.release_status.title[lang],
										text: project.release_status.text[lang],
										platforms: project.release_status.platforms.map((platform) => ({ name: platform.name[lang], state: platform.state[lang] })),
									}
								: undefined
						}
						status_label={'in_progress' in project && project.in_progress ? t(lang, 'projects.in_progress') : undefined}
						architecture_styles={project.architecture_style.map((style) => style[lang])}
						tagline={project.tagline[lang]}
						points={project.points.map((point) => point[lang])}
						technologies={project.technologies}
						repository={'repository' in project ? project.repository : undefined}
						architecture_layers={project.architecture.map((layer) => ({
							...layer,
							label: layer.label[lang],
							nodes: layer.nodes.map((node) => ({ ...node, role: node.role[lang] })),
							link: 'link' in layer ? { kind: layer.link.kind as 'sync' | 'async', label: layer.link.label[lang] } : undefined,
						}))}
						architecture_legend={{ sync: t(lang, 'projects.link_sync'), async: t(lang, 'projects.link_async') }}
						metrics={'metrics' in project && Array.isArray(project.metrics) ? project.metrics.map((metric) => ({ value: metric.value, label: metric.label[lang] })) : undefined}
						pipeline_steps={'pipeline' in project ? project.pipeline[lang] : undefined}
						pipeline_note={'pipeline_note' in project ? project.pipeline_note[lang] : undefined}
						default_tab={'default_tab' in project ? project.default_tab : undefined}
						tab_labels={{
							architecture: t(lang, 'projects.tab_architecture'),
							pipeline: t(lang, 'projects.tab_pipeline'),
						}}
						tabs_label={t(lang, 'projects.tabs_label')}
						architecture_label={t(lang, 'projects.architecture_label')}
						architecture_hint={t(lang, 'projects.architecture_hint')}
						pipeline_label={'pipeline_label' in project ? project.pipeline_label[lang] : t(lang, 'projects.pipeline_label')}
						repository_label={t(lang, 'projects.repository')}
					/>
					</ProjectTile>
				))
			}
		</div>
	</Section>

	<Section id="skills" eyebrow={t(lang, 'skills.eyebrow')} title={t(lang, 'skills.heading')}>
		<div class="skill-grid">
			{
				skills.map((group, index) => (
					<SkillGroup
						label={group.label[lang]}
						skills={group.skills}
						index={index}
						learning_label={'learning' in group ? t(lang, 'skills.learning') : undefined}
					/>
				))
			}
		</div>
	</Section>

	<Section id="education" eyebrow={t(lang, 'education.eyebrow')} title={t(lang, 'education.heading')}>
		<div class="education-grid">
			{
				education.degrees.map((degree) => (
					<article class="glass spot education-card education-card--degree" data-reveal>
						<header class="education-card__head">
							<span class="education-card__icon" aria-hidden="true">
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
									<path d={education_icons.degree} />
								</svg>
							</span>
							<p class="bento__label">{t(lang, 'education.title')}</p>
						</header>
						<h3>{degree.institution[lang]}</h3>
						<p>{degree.program[lang]}</p>
						<ul class="education-card__meta">
							<li>{degree.period[lang]}</li>
							<li>{degree.location[lang]}</li>
						</ul>
					</article>
				))
			}
			{
				education.achievements.map((achievement, index) => (
					<article class="glass spot education-card" data-reveal style={`--delay: ${(index + 1) * 90}ms`}>
						<header class="education-card__head">
							<span class="education-card__icon" aria-hidden="true">
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
									<path d={education_icons[achievement.icon as keyof typeof education_icons]} />
								</svg>
							</span>
							<p class="bento__label">{achievement.label[lang]}</p>
						</header>
						{achievement.text[lang].includes(' · ') ? (
							<ul class="education-card__meta">
								{achievement.text[lang].split(' · ').map((item) => <li>{item}</li>)}
							</ul>
						) : (
							<p>{achievement.text[lang]}</p>
						)}
					</article>
				))
			}
		</div>
	</Section>

	<section class="section contact" id="contact" aria-labelledby="contact-title">
		<div class="container">
			<div class="contact__card glass" data-reveal>
					<img class="contact__photo" src="/mehmet-guzel.png" alt="Mehmet Güzel" width="128" height="128" loading="lazy" />
				<p class="eyebrow">{t(lang, 'contact.eyebrow')}</p>
				<h2 class="contact__title" id="contact-title">{t(lang, 'contact.heading')}</h2>
				<p class="contact__lead">{t(lang, 'contact.lead')}</p>
				<p class="contact__email">
					<a href={`mailto:${contact.email}`}>{contact.email}</a>
				</p>
				<div class="contact__actions">
					<button type="button" class="btn btn--primary" data-copy={contact.email} data-copied={t(lang, 'contact.copied')}>
						{t(lang, 'contact.copy')}
					</button>
					<a class="btn" href={contact.linkedin} rel="noopener" target="_blank">LinkedIn ↗</a>
					<a class="btn" href={contact.github} rel="noopener" target="_blank">GitHub ↗</a>
					<a class="btn" href={lang === 'tr' ? '/Mehmet_Guzel_CV.pdf' : '/Mehmet_Guzel_CV_EN.pdf'} download>{t(lang, 'nav.cv_download')} ↓</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	const timeline = document.querySelector<HTMLElement>('.timeline');
	const update_timeline = () => {
		if (!timeline) return;
		const box = timeline.getBoundingClientRect();
		const fraction = (innerHeight * 0.6 - box.top) / box.height;
		timeline.style.setProperty('--fill', String(Math.min(1, Math.max(0, fraction))));
	};
	addEventListener('scroll', update_timeline, { passive: true });
	update_timeline();

	const copy_button = document.querySelector<HTMLButtonElement>('[data-copy]');
	copy_button?.addEventListener('click', async () => {
		const original_label = copy_button.textContent;
		try {
			await navigator.clipboard.writeText(copy_button.dataset.copy ?? '');
			copy_button.textContent = copy_button.dataset.copied ?? '';
			setTimeout(() => (copy_button.textContent = original_label), 1800);
		} catch {
			location.href = `mailto:${copy_button.dataset.copy}`;
		}
	});
</script>

<style>
	.pillars {
		display: grid;
		gap: 1.1rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
	}

	.pillar {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.75rem;
	}

	.pillar__number {
		color: var(--accent);
		font: 500 0.8rem var(--font-heading);
	}

	.pillar h3 {
		font-size: 1.25rem;
	}

	.pillar p {
		color: var(--muted);
	}

	.bento__label {
		color: var(--muted);
		font-family: var(--font-heading);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.timeline {
		--timeline-offset: 1.6rem;
		position: relative;
		display: grid;
		gap: 1.5rem;
		padding-left: calc(var(--timeline-offset) + 0.4rem);
	}

	@media (min-width: 48rem) {
		.timeline {
			--timeline-offset: 2.4rem;
		}
	}

	.timeline__rail {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0.3rem;
		width: 2px;
		background: var(--border);
	}

	.timeline__fill {
		position: absolute;
		inset: 0;
		background: var(--gradient);
		transform: scaleY(var(--fill, 0));
		transform-origin: top;
	}

	.project-grid {
		display: grid;
		gap: 1.1rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
	}

	.skill-grid {
		display: grid;
		gap: 1.1rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
	}

	.education-grid {
		display: grid;
		gap: 1.1rem;
	}

	@media (min-width: 48rem) {
		.education-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.education-card--degree {
			grid-column: 1 / -1;
		}
	}

	.education-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.8rem;
		padding: 1.75rem;
		color: var(--muted);
	}

	.education-card--degree {
		border-color: color-mix(in srgb, var(--accent) 35%, transparent);
		background-image: linear-gradient(135deg, color-mix(in srgb, var(--accent) 9%, transparent), transparent 55%);
	}

	.education-card__head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.education-card__icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		color: var(--accent);
	}

	.education-card__icon svg {
		width: 1.35rem;
		height: 1.35rem;
	}

	.education-card h3 {
		color: var(--text);
		font-size: clamp(1.4rem, 3vw, 1.8rem);
		line-height: 1.2;
	}

	.education-card__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: auto;
		padding: 0;
		list-style: none;
	}

	.education-card__meta li {
		padding: 0.25rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--text);
		font: 400 0.78rem/1.5 var(--font-heading);
	}

	.contact__card {
		position: relative;
		overflow: hidden;
		padding: clamp(2rem, 6vw, 4.5rem);
		text-align: center;
	}

	.contact__card::before {
		content: '';
		position: absolute;
		inset: -40% -10% auto;
		height: 24rem;
		background: radial-gradient(ellipse at center, color-mix(in srgb, var(--accent-2) 30%, transparent), transparent 65%);
		pointer-events: none;
	}

	.contact__card > * {
		position: relative;
	}

	.contact__photo {
		display: block;
		width: 8rem;
		height: 8rem;
		margin: 0 auto 1.5rem;
		border: 2px solid var(--border);
		border-radius: 50%;
		object-fit: cover;
	}

	.contact__card .eyebrow {
		justify-content: center;
	}

	.contact__title {
		font-size: clamp(2rem, 5vw, 3.4rem);
		font-weight: 800;
	}

	.contact__lead {
		max-width: 46ch;
		margin: 1rem auto 0;
		color: var(--muted);
		font-size: 1.1rem;
	}

	.contact__email {
		margin-top: 1.75rem;
		font-family: var(--font-heading);
		font-size: clamp(1.1rem, 3.4vw, 2rem);
		font-weight: 700;
		overflow-wrap: anywhere;
	}

	.contact__email a {
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-decoration: none;
	}

	.contact__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.8rem;
		margin-top: 2rem;
	}
</style>
