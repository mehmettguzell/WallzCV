---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import UpcomingTopics from '../../components/UpcomingTopics.astro';
import Section from '../../components/Section.astro';
import ExperienceItem from '../../components/ExperienceItem.astro';
import SkillGroup from '../../components/SkillGroup.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { languages, t, type Language } from '../../i18n';
import { estimate_reading_minutes, get_published_posts_newest_first } from '../../lib/blog';
import experience from '../../data/experience.json';
import projects from '../../data/projects.json';
import skills from '../../data/skills.json';
import education from '../../data/education.json';
import contact from '../../data/contact.json';

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const latest_posts = (await get_published_posts_newest_first()).slice(0, 3);
const date_format = new Intl.DateTimeFormat(lang, { dateStyle: 'medium' });

const pillars = [1, 2, 3, 4].map((number) => ({
	title: t(lang, `pillar.${number}.title` as 'pillar.1.title'),
	body: t(lang, `pillar.${number}.body` as 'pillar.1.body'),
}));
---

<Layout lang={lang} title={t(lang, 'home.title')} description={t(lang, 'meta.home_description')}>
	<Hero lang={lang} />

	<Section id="about" eyebrow={t(lang, 'about.eyebrow')} title={t(lang, 'about.heading')}>
		<div class="pillars">
			{
				pillars.map((pillar, index) => (
					<article class="pillar glass spot" data-reveal style={`--delay: ${index * 70}ms`}>
						<span class="pillar__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
						<h3>{pillar.title}</h3>
						<p>{pillar.body}</p>
					</article>
				))
			}
		</div>
	</Section>

	<Section id="experience" eyebrow={t(lang, 'experience.eyebrow')} title={t(lang, 'experience.heading')}>
		<div class="timeline">
			<span class="timeline__rail" aria-hidden="true"><span class="timeline__fill"></span></span>
			{
				experience.map((item) => (
					<ExperienceItem
						role={item.role[lang]}
						summary={item.summary[lang]}
						organization={item.organization}
						location={item.location[lang]}
						period={item.period[lang]}
						highlights={item.highlights.map((highlight) => highlight[lang])}
						technologies={item.technologies}
						technologies_label={t(lang, 'experience.stack')}
						proof={'proof' in item ? { ...item.proof, title: t(lang, 'experience.proof') } : undefined}
					/>
				))
			}
		</div>
	</Section>

	<Section id="projects" eyebrow={t(lang, 'projects.eyebrow')} title={t(lang, 'projects.heading')} lead={t(lang, 'projects.lead')}>
		<div class="project-grid">
			{
				projects.map((project, index) => (
					<ProjectCard
						slug={project.slug}
						index={index}
						name={project.name}
						context={'context' in project ? project.context[lang] : undefined}
						tagline={project.tagline[lang]}
						points={project.points.map((point) => point[lang])}
						technologies={project.technologies}
						repository={'repository' in project ? project.repository : undefined}
						architecture_layers={project.architecture.map((layer) => ({
							...layer,
							label: layer.label[lang],
							nodes: layer.nodes.map((node) => ({ ...node, role: node.role[lang] })),
							link: 'link' in layer ? { kind: layer.link.kind as 'sync' | 'async', label: layer.link.label[lang] } : undefined,
						}))}
						architecture_legend={{ sync: t(lang, 'projects.link_sync'), async: t(lang, 'projects.link_async') }}
						metrics={'metrics' in project && Array.isArray(project.metrics) ? project.metrics.map((metric) => ({ value: metric.value, label: metric.label[lang] })) : undefined}
						decisions={project.decisions.map((decision) => ({
							choice: decision.choice[lang],
							cost: 'cost' in decision ? decision.cost[lang] : undefined,
						}))}
						pipeline_steps={'pipeline' in project ? project.pipeline[lang] : undefined}
						pipeline_note={'pipeline_note' in project ? project.pipeline_note[lang] : undefined}
						default_tab={'default_tab' in project ? project.default_tab : undefined}
						tab_labels={{
							architecture: t(lang, 'projects.tab_architecture'),
							pipeline: t(lang, 'projects.tab_pipeline'),
							decisions: t(lang, 'projects.tab_decisions'),
						}}
						tabs_label={t(lang, 'projects.tabs_label')}
						architecture_label={t(lang, 'projects.architecture_label')}
						architecture_hint={t(lang, 'projects.architecture_hint')}
						pipeline_label={'pipeline_label' in project ? project.pipeline_label[lang] : t(lang, 'projects.pipeline_label')}
						decision_cost_label={t(lang, 'projects.decision_cost')}
						repository_label={t(lang, 'projects.repository')}
					/>
				))
			}
		</div>
	</Section>

	<Section id="skills" eyebrow={t(lang, 'skills.eyebrow')} title={t(lang, 'skills.heading')}>
		<div class="skill-grid">
			{
				skills.map((group, index) => (
					<SkillGroup
						label={group.label[lang]}
						skills={group.skills}
						index={index}
						learning_label={'learning' in group ? t(lang, 'skills.learning') : undefined}
					/>
				))
			}
		</div>
	</Section>

	<Section id="education" eyebrow={t(lang, 'education.eyebrow')} title={t(lang, 'education.heading')}>
		<div class="education-grid">
			{
				education.degrees.map((degree) => (
					<article class="glass spot education-card" data-reveal>
						<p class="bento__label">{t(lang, 'education.title')}</p>
						<h3>{degree.institution[lang]}</h3>
						<p>{degree.program[lang]}</p>
						<p class="bento__note">
							{degree.period[lang]} · {degree.location[lang]}
						</p>
					</article>
				))
			}
			{
				education.achievements.map((achievement, index) => (
					<article class="glass spot education-card" data-reveal style={`--delay: ${(index + 1) * 90}ms`}>
						<p class="bento__label">{achievement.label[lang]}</p>
						<p>{achievement.text[lang]}</p>
					</article>
				))
			}
		</div>
	</Section>

	{
		latest_posts.length > 0 && (
			<Section id="blog" eyebrow={t(lang, 'blog.eyebrow')} title={t(lang, 'blog.heading')} lead={t(lang, 'blog.lead')}>
				<UpcomingTopics lang={lang} />
					<div class="post-grid">
					{latest_posts.map((post, index) => (
						<a class="post-card glass spot" href={`/${lang}/blog/${post.id}/`} hreflang={post.data.lang} data-reveal style={`--delay: ${index * 90}ms`}>
							<p class="bento__note">
								{date_format.format(post.data.date)} · {estimate_reading_minutes(post)} {t(lang, 'blog.reading_minutes')}
							</p>
							<h3 lang={post.data.lang}>{post.data.title}</h3>
							<p lang={post.data.lang}>{post.data.summary}</p>
							<span class="post-card__cta">{t(lang, 'blog.read')} →</span>
						</a>
					))}
				</div>
				<p class="post-all" data-reveal>
					<a class="btn" href={`/${lang}/blog/`}>{t(lang, 'blog.all')} →</a>
				</p>
			</Section>
		)
	}

	<section class="section contact" id="contact" aria-labelledby="contact-title">
		<div class="container">
			<div class="contact__card glass" data-reveal>
					<img class="contact__photo" src="/mehmet-guzel.png" alt="Mehmet Güzel" width="128" height="128" loading="lazy" />
				<p class="eyebrow">{t(lang, 'contact.eyebrow')}</p>
				<h2 class="contact__title" id="contact-title">{t(lang, 'contact.heading')}</h2>
				<p class="contact__lead">{t(lang, 'contact.lead')}</p>
				<p class="contact__email">
					<a href={`mailto:${contact.email}`}>{contact.email}</a>
				</p>
				<div class="contact__actions">
					<button type="button" class="btn btn--primary" data-copy={contact.email} data-copied={t(lang, 'contact.copied')}>
						{t(lang, 'contact.copy')}
					</button>
					<a class="btn" href={contact.linkedin} rel="noopener" target="_blank">LinkedIn ↗</a>
					<a class="btn" href={contact.github} rel="noopener" target="_blank">GitHub ↗</a>
					<a class="btn" href={lang === 'tr' ? '/Mehmet_Guzel_CV.pdf' : '/Mehmet_Guzel_CV_EN.pdf'} download>{t(lang, 'nav.cv_download')} ↓</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	const timeline = document.querySelector<HTMLElement>('.timeline');
	const update_timeline = () => {
		if (!timeline) return;
		const box = timeline.getBoundingClientRect();
		const fraction = (innerHeight * 0.6 - box.top) / box.height;
		timeline.style.setProperty('--fill', String(Math.min(1, Math.max(0, fraction))));
	};
	addEventListener('scroll', update_timeline, { passive: true });
	update_timeline();

	const copy_button = document.querySelector<HTMLButtonElement>('[data-copy]');
	copy_button?.addEventListener('click', async () => {
		const original_label = copy_button.textContent;
		try {
			await navigator.clipboard.writeText(copy_button.dataset.copy ?? '');
			copy_button.textContent = copy_button.dataset.copied ?? '';
			setTimeout(() => (copy_button.textContent = original_label), 1800);
		} catch {
			location.href = `mailto:${copy_button.dataset.copy}`;
		}
	});
</script>

<style>
	.pillars {
		display: grid;
		gap: 1.1rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
	}

	.pillar {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.75rem;
	}

	.pillar__number {
		color: var(--accent);
		font: 500 0.8rem var(--font-heading);
	}

	.pillar h3 {
		font-size: 1.25rem;
	}

	.pillar p {
		color: var(--muted);
	}

	.bento__label {
		color: var(--muted);
		font-family: var(--font-heading);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.bento__note {
		color: var(--muted);
		font-size: 0.88rem;
	}

	.timeline {
		--timeline-offset: 1.6rem;
		position: relative;
		display: grid;
		gap: 1.5rem;
		padding-left: calc(var(--timeline-offset) + 0.4rem);
	}

	@media (min-width: 48rem) {
		.timeline {
			--timeline-offset: 2.4rem;
		}
	}

	.timeline__rail {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0.3rem;
		width: 2px;
		background: var(--border);
	}

	.timeline__fill {
		position: absolute;
		inset: 0;
		background: var(--gradient);
		transform: scaleY(var(--fill, 0));
		transform-origin: top;
	}

	.project-grid {
		display: grid;
		gap: clamp(1.5rem, 3vw, 2.25rem);
	}

	.skill-grid {
		display: grid;
		gap: 1.1rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
	}

	.education-grid {
		display: grid;
		gap: 1.1rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
	}

	.education-card {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.75rem;
		color: var(--muted);
	}

	.education-card h3 {
		color: var(--text);
		font-size: 1.4rem;
	}

	.post-grid {
		display: grid;
		margin-top: 1.75rem;
		gap: 1.1rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
	}

	.post-card {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		padding: 1.75rem;
		color: var(--muted);
		text-decoration: none;
		transition:
			transform 0.3s ease,
			border-color 0.3s ease;
	}

	.post-card:hover {
		transform: translateY(-4px);
		border-color: var(--accent);
	}

	.post-card h3 {
		color: var(--text);
		font-size: 1.3rem;
	}

	.post-card__cta {
		margin-top: auto;
		color: var(--accent);
		font-weight: 600;
	}

	.post-all {
		margin-top: 2rem;
	}

	.contact__card {
		position: relative;
		overflow: hidden;
		padding: clamp(2rem, 6vw, 4.5rem);
		text-align: center;
	}

	.contact__card::before {
		content: '';
		position: absolute;
		inset: -40% -10% auto;
		height: 24rem;
		background: radial-gradient(ellipse at center, color-mix(in srgb, var(--accent-2) 30%, transparent), transparent 65%);
		pointer-events: none;
	}

	.contact__card > * {
		position: relative;
	}

	.contact__photo {
		display: block;
		width: 8rem;
		height: 8rem;
		margin: 0 auto 1.5rem;
		border: 2px solid var(--border);
		border-radius: 50%;
		object-fit: cover;
	}

	.contact__card .eyebrow {
		justify-content: center;
	}

	.contact__title {
		font-size: clamp(2rem, 5vw, 3.4rem);
		font-weight: 800;
	}

	.contact__lead {
		max-width: 46ch;
		margin: 1rem auto 0;
		color: var(--muted);
		font-size: 1.1rem;
	}

	.contact__email {
		margin-top: 1.75rem;
		font-family: var(--font-heading);
		font-size: clamp(1.1rem, 3.4vw, 2rem);
		font-weight: 700;
		overflow-wrap: anywhere;
	}

	.contact__email a {
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-decoration: none;
	}

	.contact__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.8rem;
		margin-top: 2rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card {
			transition: none;
		}

		.post-card:hover {
			transform: none;
		}
	}
</style>
